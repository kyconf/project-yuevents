# Backend environment variables

# FastAPI
APP_NAME="Event Aggregator Backend"
APP_ENV="development"
APP_PORT=8000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yuevents
DB_USER=postgres
DB_PASS=yourpassword

# JWT / security
